# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/namitaji?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Razorpay (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set the same value in Razorpay Dashboard > Webhooks (event: payment.captured), endpoint: <your-domain>/api/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Admin bootstrap (used only by backend/utils/seed.js to create the first admin)
ADMIN_EMAIL=admin@namitaji.com
ADMIN_PASSWORD=change_this_before_seeding

# SMTP (welcome email on signup). Gmail: use an App Password, not your login
# password — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Namita Ji <you@gmail.com>
